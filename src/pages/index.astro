---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getMessages } from '../i18n';
import { homePath, internationalLang, langs, languageStorageKey, locales } from '../i18n/config';
import { selectorGraph } from '../data/structured-data';

// "/" belongs to no language: it is the x-default of the site and lists every language as plain links.
// A small inline script sends visitors on to their language when it is known: a language they chose
// earlier, otherwise the main language of the browser if the site has it. Anyone else (other browser
// language, no JavaScript, crawlers) stays here and chooses. The home pages also offer a dismissible
// suggestion based on the browser language (components/LanguageBanner.astro).
const { selector, meta } = getMessages(internationalLang).ui;
const structuredData = selectorGraph(Astro.site!);
const homes = Object.fromEntries(langs.map((code) => [code, homePath(code)]));
---
<BaseLayout
	lang={internationalLang}
	title={selector.title}
	description={selector.description}
	socialTitle={meta.socialTitle}
	skipLink={false}
>
	<script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<script slot="head" is:inline define:vars={{ homes, storageKey: languageStorageKey }}>
		// Runs in <head>, before the selector is painted. replace() keeps "/" out of the history, so Back
		// does not bounce the visitor here again. Crawlers keep the selector, the x-default of the site.
		(() => {
			if (/bot|crawl|spider|slurp/i.test(navigator.userAgent)) return;
			let chosen = null;
			try {
				chosen = localStorage.getItem(storageKey);
			} catch {
				// storage unavailable: fall back to the browser language
			}
			const primary = (navigator.languages?.[0] ?? navigator.language ?? '').toLowerCase().split('-')[0];
			const target = [chosen, primary].find((code) => code && Object.hasOwn(homes, code));
			if (target) location.replace(homes[target]);
		})();
	</script>

	<main class="selector container">
		<p class="selector-brand brand">
			<Icon name="logo" />
			<span class="wordmark">mon<b>cycle</b>.app</span>
		</p>
		<ul class="selector-list">
			{langs.map((code) => {
				const block = getMessages(code).ui.selector;
				return (
					<li lang={locales[code].htmlLang}>
						<p>{block.text}</p>
						<a class="button button-primary" href={homePath(code)} hreflang={locales[code].htmlLang} data-lang-choice={code}>{block.cta}</a>
					</li>
				);
			})}
		</ul>
	</main>
</BaseLayout>
