---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getMessages } from '../i18n';
import { homePath, internationalLang, langs, locales } from '../i18n/config';
import { selectorGraph } from '../data/structured-data';

// "/" belongs to no language: it is the x-default of the site and lists every language as plain links.
// There is deliberately no automatic redirect (crawlers must see every version); the home pages offer
// a dismissible suggestion based on the browser language instead (components/LanguageBanner.astro).
const { selector } = getMessages(internationalLang).ui;
const structuredData = selectorGraph(Astro.site!);
---
<BaseLayout
	lang={internationalLang}
	title={selector.title}
	description={selector.description}
	skipLink={false}
>
	<script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	<main class="selector container">
		<p class="selector-brand brand">
			<Icon name="logo" />
			<span class="wordmark">mon<b>cycle</b>.app</span>
		</p>
		<ul class="selector-list">
			{langs.map((code) => {
				const block = getMessages(code).ui.selector;
				return (
					<li lang={locales[code].htmlLang}>
						<p>{block.text}</p>
						<a class="button button-primary" href={homePath(code)} hreflang={locales[code].htmlLang} data-lang-choice={code}>{block.cta}</a>
					</li>
				);
			})}
		</ul>
	</main>
</BaseLayout>
