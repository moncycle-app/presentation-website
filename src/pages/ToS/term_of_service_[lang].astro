---
import type { GetStaticPaths } from 'astro';
import { legalPath, type Lang } from '../../i18n/config';

// Former URLs of the terms of use, published before the site became multilingual:
// /ToS/term_of_service_fr.html and /ToS/term_of_service_en.html. GitHub Pages cannot send a 301, so these
// pages point to the new URL with a canonical link and an immediate refresh. Do not add languages here.
export const getStaticPaths = (() => [{ params: { lang: 'fr' } }, { params: { lang: 'en' } }]) satisfies GetStaticPaths;

const target = new URL(legalPath(Astro.params.lang as Lang), Astro.site).href;
---
<!doctype html>
<html lang={Astro.params.lang}>
<head>
	<meta charset="utf-8">
	<title>moncycle.app</title>
	<link rel="canonical" href={target}>
	<meta http-equiv="refresh" content={`0; url=${target}`}>
</head>
<body>
	<p><a href={target}>{target}</a></p>
</body>
</html>
