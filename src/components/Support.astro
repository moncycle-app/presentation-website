---
import Icon from './Icon.astro';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { support } = getMessages(Astro.props.lang).home;
---
<!-- Support -->
<section class="section section-alt" id="support" aria-labelledby="support-title">
	<div class="container">
		<div class="support">
			<div>
				<h2 id="support-title">{support.title}</h2>
				<p set:html={support.intro} />
				<p set:html={support.details} />
			</div>
			<div class="support-cta">
				<Icon name="heart" class="icon-heart" />
				<!-- CONFIG: HelloAsso donation page. This href is the only place the URL lives (placeholder until the page exists). -->
				<a class="button button-primary" href="#support" id="donate-link">{support.button}</a>
				<p>{support.note}</p>
			</div>
		</div>
	</div>
</section>
