---
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const m = getMessages(Astro.props.lang);
const { methods: section } = m.home;
const { methods } = m;
---
<!-- Natural methods -->
<section class="section" id="methods" aria-labelledby="methods-title">
	<div class="container">
		<div class="section-head">
			<h2 id="methods-title">{section.title}</h2>
		</div>

		<blockquote class="methods-quote prose" cite={section.quoteUrl}>
			<p set:html={section.quote} />
			<footer set:html={section.quoteSource} />
		</blockquote>

		<p class="prose" set:html={section.intro} />

		<div class="methods-grid">
		<ul class="method-list">
					{methods.map(({ name, compatibility, badge, text }) => (
						<li>
							<h3>{name}</h3>
							<span class={`badge badge-${compatibility}`}>{badge}</span>
							<p set:html={text} />
						</li>
					))}
				</ul>

		<div class="brain">
			<h3>{section.interpretation.title}</h3>
			<p set:html={section.interpretation.text} />
		</div>
		</div>
	</div>
</section>
