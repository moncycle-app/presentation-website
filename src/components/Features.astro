---
import Icon from './Icon.astro';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';
import { endpoints, figuresDate } from '../data/site';

interface Props {
	lang: Lang;
}

const { featureGroups, home } = getMessages(Astro.props.lang);
const { features } = home;
const { figures } = features;
---
<!-- Features -->
<section class="section" id="features" aria-labelledby="features-title">
	<div class="container">
		<div class="section-head">
			<h2 id="features-title">{features.title}</h2>
			<p class="lead" set:html={features.lead} />
		</div>

		<div class="feature-groups">
			{featureGroups.map(({ title, features }) => (
				<div class="feature-group">
					<h3>{title}</h3>
					<ul class="feature-list">
						{features.map((feature) => (
							<li><Icon name={feature.icon} /><p><strong set:html={feature.title} /> <span set:html={feature.text} /></p></li>
						))}
					</ul>
				</div>
			))}
		</div>

		<!--
				CONFIG: key figures, refreshed on load from data-stats-src (rounded by the server), counted up when scrolled into view.
				Both formats are read: v1 https://tableau.moncycle.app/api/pub_stat
				and v2 https://dev.moncycle.app/api/v2/pub_stat ((data object)).
				The numbers and date below are the fallback when the API cannot be reached.
				The URL comes from PUBLIC_STATS_URL (see .env.example).
			-->
		<h3 class="visually-hidden" id="figures-title">{figures.title}</h3>
		<dl class="figures" aria-labelledby="figures-title" data-stats-src={endpoints.stats}>
			<div><dt>{figures.accounts.label}</dt><dd data-stat="accounts" set:html={figures.accounts.value} /></div>
			<div><dt>{figures.cycles.label}</dt><dd data-stat="cycles" set:html={figures.cycles.value} /></div>
			<div><dt>{figures.observations.label}</dt><dd data-stat="observations" set:html={figures.observations.value} /></div>
		</dl>
		<p class="figures-date">{figures.dateBefore}<time data-stats-date datetime={figuresDate} set:html={figures.dateLabel} />{figures.dateAfter}</p>
	</div>
</section>
