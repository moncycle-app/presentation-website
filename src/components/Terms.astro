---
import { getMessages } from '../i18n';
import { legalPath, locales, otherLangs, type Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { terms } = getMessages(lang).home;
const more = terms.more.replace('{terms}', legalPath(lang));
const others = otherLangs(lang);
---
<!-- Terms of service summary -->
<section class="section" id="terms" aria-labelledby="terms-title">
	<div class="container">
		<div class="section-head">
			<h2 id="terms-title">{terms.title}</h2>
			<p class="lead" set:html={terms.lead} />
		</div>
		<ol class="terms-list">
			{terms.items.map((item) => <li><p set:html={item} /></li>)}
		</ol>
		<p>
			<Fragment set:html={more} />
			{others.length > 0 && (
				<>
					<Fragment set:html={terms.alsoAvailable} />
					{others.map((code, i) => (
						<>{i > 0 && ', '}<a href={legalPath(code)} hreflang={locales[code].htmlLang} lang={locales[code].htmlLang}>{locales[code].label}</a></>
					))}.
				</>
			)}
		</p>
	</div>
</section>
