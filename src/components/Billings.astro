---
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { billings } = getMessages(Astro.props.lang).home;
const { reference, turningPoint } = billings;
const [summary, ...conclusion] = turningPoint.paragraphs;
---
<!-- John and Evelyn Billings -->
<section class="section" id="billings" aria-labelledby="billings-title">
	<div class="container">
		<div class="section-head">
			<p class="eyebrow">{billings.eyebrow}</p>
			<h2 id="billings-title">{billings.title}</h2>
			<p class="lead" set:html={billings.lead} />
		</div>

		<div class="billings-grid">
			<div class="prose">
				<ol class="timeline">
					{billings.timeline.map(({ datetime, label, text }) => (
						<li>
							<time datetime={datetime}>{label}</time>
							<p set:html={text} />
						</li>
					))}
				</ol>
			</div>

			<aside class="billings-aside" aria-labelledby="billings-ref-title">
				<div class="reference">
					<h3 id="billings-ref-title">{reference.title}</h3>
					<p lang="en" set:html={reference.citation} />
					<h3>{reference.sourcesTitle}</h3>
					<ul>
						{reference.sources.map(({ href, hreflang, label }) => <li><a href={href} hreflang={hreflang} target="_blank" rel="noopener">{label}</a></li>)}
					</ul>
				</div>
			</aside>
		</div>

		<div class="turning-point">
			<div>
				<h3>{turningPoint.title}</h3>
				<p set:html={summary} />
			</div>
			{conclusion.map((paragraph) => <p class="turning-point-statement" set:html={paragraph} />)}
		</div>
	</div>
</section>
