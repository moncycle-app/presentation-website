---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getMessages } from '../i18n';
import { homePath, langs, type Lang } from '../i18n/config';
import { donationsEnabled, urls } from '../data/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { header } = getMessages(lang).ui;
const links = header.links.filter(({ href }) => donationsEnabled || href !== '#support');
const paths = Object.fromEntries(langs.map((code) => [code, homePath(code)])) as Record<Lang, string>;
---
<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="#top">
			<Icon name="logo" />
			<span class="wordmark">mon<b>cycle</b>.app</span>
		</a>
		<div class="header-actions">
			<a class="button button-secondary button-small header-board" href={urls.app} target="_blank" rel="noopener">{header.board}</a>
			<a class="button button-primary button-small header-register" href={urls.register} target="_blank" rel="noopener">{header.register}</a>
		</div>
		<LanguageSwitcher lang={lang} paths={paths} />
		<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
			<Icon name="menu" />
			<span>{header.menu}</span>
		</button>
		<nav class="site-nav" id="site-nav" aria-label={header.navLabel}>
			<ul>
				{links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
			</ul>
		</nav>
	</div>
</header>
