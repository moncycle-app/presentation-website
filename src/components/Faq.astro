---
import { getMessages } from '../i18n';
import { legalPath, type Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { faq, home } = getMessages(lang);
const lead = home.faq.lead.replace('{terms}', legalPath(lang));
---
<!-- FAQ -->
<section class="section" id="faq" aria-labelledby="faq-title">
	<div class="container faq-layout">
		<div class="section-head">
			<h2 id="faq-title">{home.faq.title}</h2>
			<p class="lead" set:html={lead} />
		</div>

		<div class="faq-main">
			<div class="faq-list">
				{faq.map(({ id, question, answer }) => (
					<details id={id}>
						<summary><h3 set:html={question} /></summary>
						<div class="faq-answer" set:html={answer.join('\n')} />
					</details>
				))}
			</div>

			<p class="note prose" set:html={home.faq.warning} />
		</div>
	</div>
</section>
