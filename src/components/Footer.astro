---
import { Picture } from 'astro:assets';
import EmailLink from './EmailLink.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import coupleCrop from '../assets/images/moncycle_app_couple_crop_web.png';
import { getMessages } from '../i18n';
import { homePath, langs, legalPath, type Lang } from '../i18n/config';
import { donationsEnabled, urls } from '../data/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { footer } = getMessages(lang).ui;
const paths = Object.fromEntries(langs.map((code) => [code, homePath(code)])) as Record<Lang, string>;
---
<footer class="site-footer">
	<div class="container">
		<div class="footer-top">
			<div class="footer-brand">
				<a class="brand" href="#top">
					<Icon name="logo" />
					<span class="wordmark">mon<b>cycle</b>.app</span>
				</a>
				<Picture
					src={coupleCrop}
					class="footer-couple"
					alt={footer.coupleAlt}
					formats={['webp']}
					fallbackFormat="png"
					widths={[236, 472]}
					sizes="7rem"
				/>
				<p set:html={footer.about} />
			</div>
			<div class="footer-col">
				<h2>{footer.organization.title}</h2>
				<ul>
					<li><a href={urls.tech4fertility} target="_blank" rel="noopener">tech4fertility.org</a></li>
					{donationsEnabled && <li><a href="#support">{footer.organization.donate}</a></li>}
					<li><a href={legalPath(lang)}>{footer.organization.terms}</a></li>
					<li data-news-nav hidden><a href="#news">{footer.organization.news}</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>{footer.technical.title}</h2>
				<ul>
					<li><a href={urls.github} target="_blank" rel="noopener">{footer.technical.source}</a></li>
					<li><a href="https://tableau.moncycle.app/api" target="_blank" rel="noopener">{footer.technical.api}</a></li>
					<li><a href={urls.docker} target="_blank" rel="noopener">{footer.technical.docker}</a></li>
					<li><a href={urls.yunohost} target="_blank" rel="noopener">{footer.technical.yunohost}</a></li>
					<li><a href={urls.status} target="_blank" rel="noopener">{footer.technical.status}</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>{footer.help.title}</h2>
				<ul>
					{footer.help.links.map(({ label, href }) => <li><a href={href} target="_blank" rel="noopener">{label}</a></li>)}
					<li><a href="#faq">{footer.help.faq}</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h2>{footer.contact.title}</h2>
				<ul>
					<li><EmailLink alt={footer.contact.emailAlt} width={166} /></li>
				</ul>
			</div>
		</div>
		<div class="footer-bottom">
			<p set:html={footer.credits} />
			<LanguageSwitcher lang={lang} paths={paths} variant="footer" />
		</div>
	</div>
</footer>
