---
import Gallery from './Gallery.astro';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';
import { urls } from '../data/site';

interface Props {
	lang: Lang;
}

const { demo } = getMessages(Astro.props.lang).home;
const { lang } = Astro.props;
---
<!-- Screenshots and demo -->
<section class="section" id="demo" aria-labelledby="demo-title">
	<div class="container">
		<div class="section-head">
			<h2 id="demo-title">{demo.title}</h2>
			<p class="lead" set:html={demo.lead} />
		</div>

		<div class="demo-grid">
			<figure class="demo-video">
				<video class="device" width="720" height="1558" muted loop playsinline preload="none" poster="/video/demo-poster.webp">
					<source src="/video/demo.mp4" type="video/mp4">
				</video>
				<figcaption>{demo.videoCaption}</figcaption>
			</figure>

			<div class="card demo-accounts" id="demo-accounts">
				<h3>{demo.accounts.title}</h3>
				<p set:html={demo.accounts.text} />
				<dl>
					<dt>{demo.accounts.billings}</dt>
					<dd><code>demo.bl@moncycle.app</code></dd>
					<dt>{demo.accounts.fertilityCare}</dt>
					<dd><code>demo.fc@moncycle.app</code></dd>
					<dt>{demo.accounts.password}</dt>
					<dd><code>demo</code></dd>
				</dl>
				<a class="button button-primary" href={urls.app} target="_blank" rel="noopener">{demo.accounts.button}</a>
			</div>
		</div>

		<Gallery lang={lang} />
	</div>
</section>
