---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import couplePng from '../assets/images/moncycle_app_couple_web.png';
import coupleCropPng from '../assets/images/moncycle_app_couple_crop_web.png';
import screenLightPng from '../assets/images/hero_screen_light.png';
import screenDarkPng from '../assets/images/hero_screen_dark.png';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';
import { urls } from '../data/site';

interface Props {
	lang: Lang;
}

const { hero } = getMessages(Astro.props.lang).home;

// Art direction: the tall drawing from 48rem, the cropped one below (webp first, png as fallback)
const optimise = async (image: ImageMetadata) => ({
	image,
	webp: (await getImage({ src: image, format: 'webp' })).src,
});
const couple = await optimise(couplePng);
const coupleCrop = await optimise(coupleCropPng);

// App screenshot: one version per colour scheme, each as webp + png at two widths
const screenWidths = [360, 720];
const srcset = async (src: ImageMetadata, format: 'webp' | 'png') =>
	(await Promise.all(screenWidths.map(async (width) => `${(await getImage({ src, format, width })).src} ${width}w`))).join(', ');
const screen = {
	light: { webp: await srcset(screenLightPng, 'webp'), png: await srcset(screenLightPng, 'png') },
	dark: { webp: await srcset(screenDarkPng, 'webp'), png: await srcset(screenDarkPng, 'png') },
};
const screenSizes = '(min-width: 48rem) 10rem, 9rem';
const screenFallback = await getImage({ src: screenLightPng, format: 'png', width: 360 });
---
<!-- Hero -->
<section class="hero" id="top" aria-labelledby="hero-title">
	<div class="container hero-grid">
		<div>
			<p class="eyebrow rise">{hero.eyebrow}</p>
			<h1 id="hero-title" class="rise rise-2" set:html={hero.title} />
			<p class="lead rise rise-3" set:html={hero.lead} />
			<div class="hero-actions rise rise-4">
				<a class="button button-primary" href={urls.register} target="_blank" rel="noopener">{hero.primary}</a>
				<a class="button button-secondary" href="#demo">{hero.secondary}</a>
			</div>
			<p class="hero-small rise rise-4" set:html={hero.small} />
		</div>
		<div class="hero-visual">
			<picture>
					<source media="(min-width: 48rem)" type="image/webp" srcset={couple.webp} width={couple.image.width} height={couple.image.height}>
					<source media="(min-width: 48rem)" srcset={couple.image.src} width={couple.image.width} height={couple.image.height}>
					<source type="image/webp" srcset={coupleCrop.webp} width={coupleCrop.image.width} height={coupleCrop.image.height}>
					<img src={coupleCrop.image.src} width={coupleCrop.image.width} height={coupleCrop.image.height} fetchpriority="high" alt={hero.coupleAlt}>
				</picture>
			<div class="hero-squares" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
			<div class="hero-screen device">
				<picture>
					<source media="(prefers-color-scheme: dark)" type="image/webp" srcset={screen.dark.webp} sizes={screenSizes}>
					<source media="(prefers-color-scheme: dark)" srcset={screen.dark.png} sizes={screenSizes}>
					<source type="image/webp" srcset={screen.light.webp} sizes={screenSizes}>
					<img
						src={screenFallback.src}
						srcset={screen.light.png}
						sizes={screenSizes}
						width={screenLightPng.width}
						height={screenLightPng.height}
						alt={hero.screenshotAlt}
						loading="eager"
					>
				</picture>
			</div>
		</div>
	</div>
</section>
