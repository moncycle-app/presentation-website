---
import Icon from './Icon.astro';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { home, techLinks } = getMessages(Astro.props.lang);
const { tech } = home;
---
<!-- Technical -->
<section class="section" id="tech" aria-labelledby="tech-title">
	<div class="container">
		<div class="section-head">
			<h2 id="tech-title">{tech.title}</h2>
			<p class="lead" set:html={tech.lead} />
		</div>
		<ul class="tech-list">
				{techLinks.map(({ icon, href, title, text }) => (
					<li>
						<Icon name={icon} />
						<h3><a href={href} target="_blank" rel="noopener" set:html={title} /></h3>
						<p set:html={text} />
					</li>
				))}
			</ul>
	</div>
</section>
