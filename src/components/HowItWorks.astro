---
import { Picture } from 'astro:assets';
import installIphone from '../assets/images/install_iphone.png';
import installAndroid from '../assets/images/install_android.png';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { how } = getMessages(Astro.props.lang).home;
---
<!-- How it works -->
<section class="section section-alt" id="how" aria-labelledby="how-title">
	<div class="container">
		<div class="section-head">
			<h2 id="how-title">{how.title}</h2>
			<p class="lead" set:html={how.lead} />
		</div>

		<ol class="steps">
			{how.steps.map(({ title, text }) => (
				<li>
					<h3>{title}</h3>
					<p set:html={text} />
				</li>
			))}
		</ol>

		<div class="install">
			<div class="prose">
				<h3 id="install">{how.install.title}</h3>
				<p set:html={how.install.intro} />
				<p set:html={how.install.steps} />
				<p class="note" set:html={how.install.note} />
			</div>
			<ul class="install-shots">
				<li>
					<figure>
						<Picture
									src={installIphone}
									alt={how.install.iphoneAlt}
									formats={['webp']}
									fallbackFormat="png"
									widths={[360, 720]}
									sizes="11rem"
									pictureAttributes={{ class: 'device' }}
								/>
						<figcaption>{how.install.iphoneCaption}</figcaption>
					</figure>
				</li>
				<li>
					<figure>
						<Picture
									src={installAndroid}
									alt={how.install.androidAlt}
									formats={['webp']}
									fallbackFormat="png"
									widths={[360, 720]}
									sizes="11rem"
									pictureAttributes={{ class: 'device' }}
								/>
						<figcaption>{how.install.androidCaption}</figcaption>
					</figure>
				</li>
			</ul>
		</div>
	</div>
</section>
