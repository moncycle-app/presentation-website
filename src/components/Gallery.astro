---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { screenshots } from '../data/screenshots';
import { getMessages } from '../i18n';
import type { Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { ui, screenshots: texts } = getMessages(Astro.props.lang);
const { gallery } = ui;
---
<div class="gallery" data-gallery>
		<div class="gallery-head">
			<h3 id="gallery-title">{gallery.title}</h3>
			<div class="gallery-controls" hidden>
				<button type="button" data-gallery-prev aria-controls="gallery-track" aria-label={gallery.previous}><Icon name="left" /></button>
				<button type="button" data-gallery-next aria-controls="gallery-track" aria-label={gallery.next}><Icon name="right" /></button>
			</div>
		</div>
		<ul class="gallery-track" id="gallery-track" tabindex="0" aria-labelledby="gallery-title">
			{screenshots.map(({ id, image, wide }) => (
				<li class:list={{ 'gallery-wide': wide }}><figure>
					<a href={image.src}>
						<Picture
							src={image}
							alt={texts[id].alt}
							formats={['webp']}
							fallbackFormat="png"
							widths={wide ? [720, 1440] : [360, 720]}
							sizes={wide ? '28rem' : '14rem'}
							pictureAttributes={{ class: 'device' }}
						/>
					</a>
					<figcaption>{texts[id].caption}</figcaption>
				</figure></li>
			))}
		</ul>
		<dialog class="lightbox" aria-label={gallery.lightbox}>
			<figure>
				<img alt="">
				<figcaption></figcaption>
			</figure>
			<button type="button" class="lightbox-close" data-lightbox-close aria-label={gallery.close}><Icon name="close" /></button>
			<button type="button" class="lightbox-prev" data-lightbox-prev aria-label={gallery.lightboxPrevious}><Icon name="left" /></button>
			<button type="button" class="lightbox-next" data-lightbox-next aria-label={gallery.lightboxNext}><Icon name="right" /></button>
		</dialog>
	</div>
