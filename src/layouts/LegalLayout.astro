---
import '../styles/legal.css';
import { getMessages } from '../i18n';
import SocialMeta from '../components/SocialMeta.astro';
import { alternates, defaultLang, homePath, legalPath, locales, otherLangs, type Lang } from '../i18n/config';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const page = getMessages(lang).legal;
const { htmlLang, dir } = locales[lang];
const canonical = new URL(legalPath(lang), Astro.site);
const versions = alternates(legalPath, Astro.site!);
const others = otherLangs(lang);
---
<!doctype html>
<html lang={htmlLang} dir={dir}>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<SocialMeta lang={lang} url={canonical} title={page.socialTitle} description={page.description} localeAlternates />
	<meta name="color-scheme" content="light dark">
	<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff">
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131715">
	<meta name="description" content={page.description}>
	<title>{page.title}</title>
	<link rel="canonical" href={canonical}>
	{versions.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href}>)}
	<link rel="alternate" hreflang="x-default" href={new URL(legalPath(defaultLang), Astro.site)}>

	<link rel="icon" href="/favicon.ico" sizes="any">
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
	<link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
	<link rel="apple-touch-icon" href="/apple-touch-icon.png">
</head>
<body>

	<nav aria-label={page.home}>
		<a href={homePath(lang)}>{page.home}</a>
	</nav>

	<header>
		<h1>{page.h1[0]}<br>{page.h1[1]}</h1>
		<p>{page.version}</p>
	</header>

	{others.length > 0 && (
		<nav aria-label={page.languageLabel}>
			<ul>
				{others.map((code) => (
					<li><a href={legalPath(code)} hreflang={locales[code].htmlLang} lang={locales[code].htmlLang}>{getMessages(code).legal.readThis}</a></li>
				))}
			</ul>
		</nav>
	)}

	<nav aria-label={page.contents.label}>
		<b>{page.contents.title}</b>
		<ol>
			{page.contents.sections.map(({ id, title }) => <li><a href={`#${id}`}>{title}</a></li>)}
		</ol>
	</nav>

	<main>
		<slot />
	</main>

	<footer>
		<p>{page.footer}</p>
	</footer>

	<script>
		import '../scripts/email';
	</script>
</body>
</html>
